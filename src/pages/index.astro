---
import Navbar from "@/components/Navbar"
import LeadForm from "@/components/LeadForm"
import { whatsappUrl } from "@/lib/whatsapp"
import "@/styles/global.css"

const whatsapp = whatsappUrl(import.meta.env.PUBLIC_WHATSAPP, "Hola, quiero hacer una consulta.")
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Asesoramiento, capacitación y automatización para hogares y empresas de Formosa. Atención remota en todo el país."
    />
    <meta name="theme-color" content="#070707" />
    <title>Gravity Digital — Tecnología que trabaja por vos</title>
  </head>
  <body>
    <div class="noise-overlay" aria-hidden="true"></div>
    <Navbar client:load />

    <main>
      <section class="hero-section" id="inicio">
        <div class="hero-video" aria-hidden="true">
          <iframe
            src="https://www.youtube-nocookie.com/embed/784dsKVrdjQ?autoplay=1&mute=1&controls=0&disablekb=1&fs=0&modestbranding=1&rel=0&playsinline=1&iv_load_policy=3"
            title="Agujero negro en movimiento"
            tabindex="-1"
            allow="autoplay; encrypted-media; picture-in-picture"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
        <div class="hero-vignette" aria-hidden="true"></div>
        <div class="hero-layout page-shell">
          <div class="hero-copy">
            <p class="eyebrow"><span class="status-dot"></span> Formosa · Atención remota</p>
            <h1>Tecnología que<br />trabaja <em>por vos.</em></h1>
            <p class="hero-description">
              Visión técnica, apoyo informático donde sea. Soluciones claras para tu casa o tu
              empresa, estés donde estés.
            </p>
            <div class="hero-actions">
              <a class="button button-light" href="#contacto">Contanos qué necesitás</a>
              <a class="text-link" href="#servicios">Conocé los servicios <span aria-hidden="true">↘</span></a>
            </div>
            <div class="hero-note">
              <span class="note-rule"></span>
              <span>Asesoramiento independiente. Recomendaciones con criterio, no por comisión.</span>
            </div>
          </div>
        </div>
        <a class="scroll-cue" href="#servicios" aria-label="Ir a servicios"><span></span></a>
      </section>

      <section class="services-section section-pad" id="servicios">
        <div class="page-shell">
          <div class="section-intro">
            <p class="eyebrow">Una mirada práctica</p>
            <h2>La tecnología, <span>en su lugar.</span></h2>
            <p>Menos vueltas técnicas. Más tiempo para lo que querés hacer.</p>
          </div>
          <div class="service-list">
            <a class="service-row" href="#asesoramiento">
              <span class="service-symbol" aria-hidden="true">⌕</span>
              <span class="service-name">Asesoramiento</span>
              <span class="service-summary">Elegí bien antes de comprar o cambiar.</span>
              <span class="service-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="service-row" href="#capacitacion">
              <span class="service-symbol" aria-hidden="true">⌘</span>
              <span class="service-name">Capacitación</span>
              <span class="service-summary">Aprendé a usar herramientas que te sirven.</span>
              <span class="service-arrow" aria-hidden="true">↗</span>
            </a>
            <a class="service-row" href="#automatizacion">
              <span class="service-symbol" aria-hidden="true">⤳</span>
              <span class="service-name">Automatización</span>
              <span class="service-summary">Sacá tareas repetidas de tu camino.</span>
              <span class="service-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="service-footnote">Para hogares, profesionales y PyMEs de cualquier rubro.</p>
        </div>
      </section>

      <section class="advice-section section-pad" id="asesoramiento">
        <div class="page-shell advice-layout">
          <div class="section-intro advice-heading">
            <p class="eyebrow">Decisiones con fundamento</p>
            <h2>Comprá lo que<br />necesitás. <span>No más.</span></h2>
            <p>
              No vendemos equipos ni cobramos comisión. Primero entendemos para qué lo vas a usar;
              después, recomendamos.
            </p>
            <a class="text-link" href="#contacto">Consultar asesoramiento <span aria-hidden="true">↘</span></a>
          </div>
          <div class="comparison">
            <div class="comparison-head">
              <span>Guía de decisión</span>
              <span>Ejemplo orientativo</span>
            </div>
            <div class="comparison-row">
              <div class="comparison-icon" aria-hidden="true">▰</div>
              <div class="comparison-copy"><strong>PC de escritorio</strong><span>Trabajo fijo, diseño o juegos</span></div>
              <span class="fit-tag">A medida</span>
            </div>
            <div class="comparison-row">
              <div class="comparison-icon" aria-hidden="true">▱</div>
              <div class="comparison-copy"><strong>Notebook</strong><span>Estudio, movilidad y uso diario</span></div>
              <span class="fit-tag">Portátil</span>
            </div>
            <div class="comparison-row">
              <div class="comparison-icon" aria-hidden="true">⌁</div>
              <div class="comparison-copy"><strong>Red para PyME</strong><span>Cobertura, estabilidad y seguridad</span></div>
              <span class="fit-tag">Conectada</span>
            </div>
            <div class="comparison-note">
              <span class="note-mark">↳</span>
              <p>Las opciones cambian según tu uso, presupuesto y lo que ya tenés.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="training-section section-pad" id="capacitacion">
        <div class="page-shell">
          <div class="section-intro training-intro">
            <p class="eyebrow">Aprender haciendo</p>
            <h2>Herramientas nuevas.<br /><span>Confianza propia.</span></h2>
            <p>
              Clases prácticas, individuales o grupales. Vamos a tu ritmo y trabajamos sobre casos
              reales, no ejercicios genéricos.
            </p>
          </div>
          <div class="training-content">
            <div class="tool-cloud" aria-label="Herramientas disponibles">
              <span>n8n</span><span>ChatGPT</span><span>Gemini</span><span>Claude</span><span>Ofimática</span>
            </div>
            <div class="training-details">
              <div>
                <h3>Lo que te llevás</h3>
                <p>Una guía de consulta después de cada clase y ejercicios para aplicar lo aprendido.</p>
              </div>
              <div class="price-stack">
                <p><strong>Desde $200.000</strong><span>por persona</span></p>
                <p><strong>Desde $700.000</strong><span>para equipos de empresa</span></p>
              </div>
            </div>
            <div class="promo-line"><span>3 × 2</span> Venís con dos personas más y una capacitación queda bonificada.</div>
          </div>
        </div>
      </section>

      <section class="automation-section section-pad" id="automatizacion">
        <div class="page-shell automation-layout">
          <div class="automation-copy">
            <p class="eyebrow">Menos tareas repetidas</p>
            <h2>Hacé que las cosas<br /><span>pasen solas.</span></h2>
            <p>
              Conectamos tus herramientas para resolver tareas de todos los días: desde ordenar
              consultas y avisos en casa hasta automatizar procesos de una empresa.
            </p>
            <a class="text-link" href="#contacto">Explorar una idea <span aria-hidden="true">↘</span></a>
          </div>
          <div class="flow-visual" aria-label="Ejemplo de flujo automatizado">
            <div class="flow-node"><span class="flow-icon">✳</span><span>Una consulta llega</span><span class="flow-port"></span></div>
            <div class="flow-connector"><span></span><i></i><span></span></div>
            <div class="flow-node flow-node-main"><span class="flow-icon">n8n</span><span>El flujo la organiza</span><span class="flow-port"></span></div>
            <div class="flow-connector"><span></span><i></i><span></span></div>
            <div class="flow-node"><span class="flow-icon">✓</span><span>La respuesta sale</span></div>
            <p>Así de simple. A tu medida, con n8n e inteligencia artificial cuando suma.</p>
          </div>
        </div>
      </section>

      <section class="process-section section-pad">
        <div class="page-shell process-layout">
          <div class="section-intro">
            <p class="eyebrow">De la idea al uso</p>
            <h2>Un camino<br /><span>sin sorpresas.</span></h2>
          </div>
          <ol class="process-list">
            <li><span>Consulta</span><p>Nos contás qué necesitás, sin tecnicismos.</p></li>
            <li><span>Diagnóstico</span><p>Revisamos el contexto y las opciones posibles.</p></li>
            <li><span>Propuesta</span><p>Recibís un plan claro, alcance y precio antes de empezar.</p></li>
            <li><span>Implementación</span><p>Lo ponemos en marcha de forma remota o coordinada.</p></li>
            <li><span>Capacitación</span><p>Te mostramos cómo usarlo y resolver lo cotidiano.</p></li>
          </ol>
        </div>
      </section>

      <section class="pricing-section section-pad">
        <div class="page-shell">
          <div class="section-intro">
            <p class="eyebrow">Una referencia, no una sorpresa</p>
            <h2>Empezá por lo <span>que necesitás.</span></h2>
            <p>Valores orientativos. Cada propuesta se confirma antes de avanzar.</p>
          </div>
          <div class="pricing-grid">
            <article class="price-entry"><span>Para tu casa</span><strong>Desde $100.000</strong><p>Asesoramiento y soporte para tus equipos y herramientas del día a día.</p><a href="#contacto">Consultar <span aria-hidden="true">↗</span></a></article>
            <article class="price-entry price-entry-featured"><span>Para tu empresa</span><strong>Desde $500.000</strong><p>Soluciones y automatización pensadas para cómo trabaja tu equipo.</p><a href="#contacto">Consultar <span aria-hidden="true">↗</span></a><small>Auditoría PyME bonificada durante el primer mes.</small></article>
          </div>
          <p class="pricing-footnote">El precio final depende del alcance, la cantidad de equipos y el acompañamiento requerido.</p>
        </div>
      </section>

      <section class="contact-section section-pad" id="contacto">
        <div class="page-shell contact-layout">
          <div class="contact-copy">
            <p class="eyebrow">Empecemos por conversar</p>
            <h2>¿Qué te gustaría<br /><span>resolver?</span></h2>
            <p>Dejanos los datos y te respondemos para entender el caso y ver los próximos pasos.</p>
            <div class="contact-meta">
              <div><span>Atención</span><strong>Formosa y todo el país, de forma remota</strong></div>
              <div><span>Medios de pago</span><strong>Transferencia, efectivo y medios digitales</strong></div>
            </div>
          </div>
          <LeadForm client:load />
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="page-shell footer-main">
        <div><a class="footer-brand font-display" href="#inicio">Gravity Digital</a><p>Visión técnica, apoyo informático donde sea.</p></div>
        <nav aria-label="Navegación del pie">
          <a href="#asesoramiento">Asesoramiento</a><a href="#capacitacion">Capacitación</a><a href="#automatizacion">Automatización</a>
        </nav>
        <a class="footer-contact" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
      </div>
      <div class="page-shell footer-bottom"><span>© {new Date().getFullYear()} Gravity Digital</span><span>Formosa, Argentina · Atención remota</span></div>
    </footer>

    {whatsapp ? (
      <a class="whatsapp-float" href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .2 5.3.2 11.9c0 2.1.6 4.2 1.6 6L0 24l6.3-1.7a12 12 0 0 0 5.8 1.5h.1c6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.3-6.2-3.6-8.4ZM12.1 21.8a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.3-.4a9.8 9.8 0 0 1-1.5-5.3c0-5.4 4.4-9.8 9.9-9.8 2.6 0 5.1 1 7 2.9a9.8 9.8 0 0 1 2.9 7c0 5.4-4.4 9.8-9.9 9.8Zm5.4-7.3c-.3-.1-1.6-.8-1.9-.9-.3-.1-.4-.1-.6.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-1.6-.8-2.7-1.5-3.8-3.3-.3-.5.3-.5.8-1.5.1-.2 0-.4 0-.5l-.8-2c-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.8.4s-1 1-1 2.3 1 2.7 1.2 2.9c.1.2 2 3.1 4.9 4.3 1.8.8 2.5.9 3.4.7.5-.1 1.6-.7 1.8-1.3.2-.6.2-1.2.1-1.3 0-.2-.2-.3-.5-.4Z"/></svg>
      </a>
    ) : (
      <button class="whatsapp-float whatsapp-disabled" type="button" disabled aria-label="WhatsApp no configurado" title="WhatsApp estará disponible próximamente">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.5 0 .2 5.3.2 11.9c0 2.1.6 4.2 1.6 6L0 24l6.3-1.7a12 12 0 0 0 5.8 1.5h.1c6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.3-6.2-3.6-8.4ZM12.1 21.8a9.9 9.9 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.3-.4a9.8 9.8 0 0 1-1.5-5.3c0-5.4 4.4-9.8 9.9-9.8 2.6 0 5.1 1 7 2.9a9.8 9.8 0 0 1 2.9 7c0 5.4-4.4 9.8-9.9 9.8Z"/></svg>
      </button>
    )}
  </body>
</html>
